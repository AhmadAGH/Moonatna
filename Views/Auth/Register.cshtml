@model LoginViewModel
@inject ILocalizationService Localization
@{
    var L = await Localization.GetStringsAsync();
    ViewData["Title"] = L.T("Register.Title");
}

<section class="auth-page">
    <div class="auth-illustration" aria-hidden="true">
        <img src="~/img/login-pattern.svg" alt="" />
    </div>

    <div class="auth-content">
        <div class="auth-brand">
            <img src="~/img/logo-lockup.svg" alt="@L.T("App.Name")" class="auth-logo" />
            <p class="auth-tagline">@L.T("App.Tagline")</p>
        </div>

        <div class="auth-card"
             id="auth-root"
             data-mode="register"
             data-api-key="@Model.FirebaseApiKey"
             data-auth-domain="@Model.FirebaseAuthDomain"
             data-project-id="@Model.FirebaseProjectId"
             data-token-url="@Url.Action("Token", "Auth")"
             data-error-text="@L.T("Register.Error")"
             data-mismatch-text="@L.T("Register.PasswordMismatch")">
            <h1 class="auth-title">@L.T("Register.Title")</h1>
            <p class="auth-subtitle">@L.T("Register.Subtitle")</p>

            <form id="auth-form" class="auth-form" novalidate>
                <label class="auth-field">
                    <span>@L.T("Register.DisplayName")</span>
                    <input type="text" id="auth-name" class="input" autocomplete="name" required />
                </label>
                <label class="auth-field">
                    <span>@L.T("Login.Email")</span>
                    <input type="email" id="auth-email" class="input" autocomplete="username" required />
                </label>
                <label class="auth-field">
                    <span>@L.T("Login.Password")</span>
                    <input type="password" id="auth-password" class="input" autocomplete="new-password" required />
                </label>
                <label class="auth-field">
                    <span>@L.T("Register.ConfirmPassword")</span>
                    <input type="password" id="auth-password-confirm" class="input" autocomplete="new-password" required />
                </label>
                <button type="submit" id="auth-submit" class="btn-primary auth-submit">@L.T("Register.Submit")</button>
            </form>

            <p id="auth-error" class="auth-error" hidden></p>

            <div class="auth-divider"><span>@L.T("Login.OrDivider")</span></div>

            <button type="button" id="google-signin" class="btn-secondary auth-google">
                <svg viewBox="0 0 18 18" width="18" height="18" aria-hidden="true">
                    <path fill="#4285F4" d="M17.64 9.2c0-.64-.06-1.25-.16-1.84H9v3.48h4.84a4.14 4.14 0 0 1-1.8 2.72v2.26h2.9c1.7-1.56 2.68-3.87 2.68-6.62z"/>
                    <path fill="#34A853" d="M9 18c2.43 0 4.47-.8 5.96-2.18l-2.9-2.26c-.8.54-1.84.86-3.06.86-2.35 0-4.34-1.59-5.05-3.72H.9v2.33A9 9 0 0 0 9 18z"/>
                    <path fill="#FBBC05" d="M3.95 10.7A5.4 5.4 0 0 1 3.66 9c0-.59.1-1.17.29-1.7V4.97H.9A9 9 0 0 0 0 9c0 1.45.35 2.83.9 4.03l3.05-2.33z"/>
                    <path fill="#EA4335" d="M9 3.58c1.32 0 2.51.45 3.44 1.35l2.58-2.58C13.46.89 11.43 0 9 0A9 9 0 0 0 .9 4.97l3.05 2.33C4.66 5.17 6.65 3.58 9 3.58z"/>
                </svg>
                @L.T("Login.SignInWithGoogle")
            </button>

            <p class="auth-switch">
                @L.T("Register.HaveAccount")
                <a asp-controller="Auth" asp-action="Login">@L.T("Register.SignIn")</a>
            </p>
        </div>
    </div>
</section>

@section Styles {
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
}

@section Scripts {
    <script type="module" src="~/js/auth.js" asp-append-version="true"></script>
}
