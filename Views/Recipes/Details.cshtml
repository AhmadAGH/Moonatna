@model RecipeDetailsViewModel
@inject ILocalizationService Localization
@{
    var L = await Localization.GetStringsAsync();
    ViewData["Title"] = Model.Name;
}

<section class="recipe-details rise">
    <header class="page-header recipe-details-header">
        <h1>@Model.Name</h1>
        <div class="overflow-menu" id="overflow-menu">
            <button type="button" class="menu-trigger" id="menu-trigger" aria-haspopup="true">⋮</button>
            <div class="menu-pop" id="menu-pop" hidden>
                <a asp-controller="Recipes" asp-action="Edit" asp-route-id="@Model.Id">@L.T("Recipes.EditButton")</a>
                <button type="button" id="delete-open" class="menu-danger">@L.T("Recipes.DeleteButton")</button>
            </div>
        </div>
    </header>

    @if (Model.MissingCount > 0)
    {
        <div class="missing-bar">
            <form asp-controller="Recipes" asp-action="AddMissing" method="post">
                <input type="hidden" name="recipeId" value="@Model.Id" />
                <button type="submit" class="btn-primary">@L.T("Recipes.AddMissing")</button>
            </form>
        </div>
    }

    <div class="card">
        <h2>@L.T("Recipes.IngredientsTitle")</h2>
        <ul class="ingredients-list">
            @foreach (var ing in Model.Ingredients)
            {
                <li class="ingredient-row @(ing.IsAvailable ? "" : "is-missing")">
                    <span class="ingredient-name">@ing.Name</span>
                    @if (!string.IsNullOrWhiteSpace(ing.QuantityText))
                    {
                        <span class="quantity">@ing.QuantityText</span>
                    }
                    @if (ing.IsOptional)
                    {
                        <span class="opt-chip">@L.T("Recipes.Optional")</span>
                    }
                    <span class="avail-chip @(ing.IsAvailable ? "avail" : "miss")">
                        @L.T(ing.IsAvailable ? "Recipes.Available" : "Recipes.Missing")
                    </span>
                </li>
            }
        </ul>
    </div>

    <div class="modal-scrim" id="delete-modal" hidden>
        <div class="modal" role="dialog" aria-modal="true">
            <h3>@L.T("Recipes.DeleteConfirmTitle")</h3>
            <p>@L.T("Recipes.DeleteConfirmBody")</p>
            <div class="modal-actions">
                <button type="button" class="btn-secondary" id="delete-cancel">@L.T("Recipes.CancelButton")</button>
                <form asp-controller="Recipes" asp-action="Archive" method="post">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <button type="submit" class="btn-danger">@L.T("Common.Confirm")</button>
                </form>
            </div>
        </div>
    </div>
</section>

@section Styles {
    <link rel="stylesheet" href="~/css/recipes.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/recipe-details.js" asp-append-version="true"></script>
}
