@model ShoppingListViewModel
@inject ILocalizationService Localization
@{
    var L = await Localization.GetStringsAsync();
    ViewData["Title"] = L.T("Shopping.Title");
    var groups = Model.Items
        .GroupBy(i => i.CategoryName)
        .OrderBy(g => g.Key is null)
        .ThenBy(g => g.Key);

    var stateKeys = new[] { "ItemState.Available", "ItemState.RunningLow", "ItemState.OutOfStock" };
}

<section class="items-page rise"
         data-purchase-url="@Url.Action("Purchase", "Items")"
         data-layout-key="shopping"
         data-uncategorized="@L.T("Common.Uncategorized")">

    <header class="page-header">
        <h1>@L.T("Shopping.Title")</h1>
        <div class="layout-toggle" role="group" aria-label="@L.T("Common.LayoutChoice")">
            <button type="button" data-layout="full" aria-pressed="true" title="@L.T("Common.LayoutFull")">
                <i class="fa-solid fa-table-cells-large" aria-hidden="true"></i>
            </button>
            <button type="button" data-layout="grid" aria-pressed="false" title="@L.T("Common.LayoutGrid")">
                <i class="fa-solid fa-grip" aria-hidden="true"></i>
            </button>
        </div>
        <button type="button" id="copy-list" class="btn-secondary"
                data-copied-text="@L.T("Shopping.Copied")"
                @(Model.Items.Count == 0 ? "hidden" : null)>
            @L.T("Shopping.CopyList")
        </button>
    </header>

    <div class="empty-state" id="empty-state" @(Model.Items.Count > 0 ? "hidden" : null)>
        <div class="lottie-mount" data-lottie="float"></div>
        <p>@L.T("Shopping.Empty")</p>
    </div>

    <div id="items-list">
        @foreach (var group in groups)
        {
            <section class="category-group" data-category-group="@(group.Key ?? "")">
                <h2>@(group.Key ?? L.T("Common.Uncategorized"))</h2>
                <ul>
                    @foreach (var item in group)
                    {
                        <li class="swipe-wrap">
                            <div class="swipe-under"><span>✓ @L.T("Shopping.Purchased")</span></div>
                            <div class="item-row" data-item-id="@item.Id" data-state="@((int)item.State)">
                                @if (!string.IsNullOrEmpty(item.ImagePath))
                                {
                                    <img class="item-thumb" src="@item.ImagePath" alt="@item.Name" loading="lazy" role="button" tabindex="0" />
                                }
                                else
                                {
                                    <span class="item-thumb item-thumb-icon">
                                        <partial name="_CategoryIcon" model="item.CategoryIcon ?? new CategoryIconViewModel()" />
                                    </span>
                                }
                                <div class="item-card-body">
                                    <span class="item-name">
                                        <span class="item-name-text">@item.Name</span>
                                        @if (item.IsAdHoc)
                                        {
                                            <span class="adhoc-tag">@L.T("Item.AdHoc")</span>
                                        }
                                    </span>
                                    @if (item.Quantity is > 0)
                                    {
                                        <span class="qty-tag">@item.Quantity</span>
                                    }
                                    <div class="row-actions">
                                        @for (var s = 0; s <= 2; s++)
                                        {
                                            var isActive = (int)item.State == s;
                                            <span class="state-opt is-readonly@(isActive ? " is-active" : "")" data-state="@s">@L.T(stateKeys[s])</span>
                                        }
                                        <button type="button" class="purchase-btn" title="@L.T("Shopping.PurchaseButton")">
                                            <i class="fa-solid fa-check" aria-hidden="true"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </li>
                    }
                </ul>
            </section>
        }
    </div>

    <template id="item-row-template">
        <li class="swipe-wrap">
            <div class="swipe-under"><span>✓ @L.T("Shopping.Purchased")</span></div>
            <div class="item-row" data-item-id="0" data-state="2">
                <img class="item-thumb" alt="" loading="lazy" role="button" tabindex="0" hidden />
                <span class="item-thumb item-thumb-icon" hidden><i class="fa-solid fa-basket-shopping" aria-hidden="true"></i></span>
                <div class="item-card-body">
                    <span class="item-name">
                        <span class="item-name-text"></span>
                        <span class="adhoc-tag">@L.T("Item.AdHoc")</span>
                    </span>
                    <span class="qty-tag" hidden></span>
                    <div class="row-actions">
                        <span class="state-opt is-readonly" data-state="0">@L.T("ItemState.Available")</span>
                        <span class="state-opt is-readonly" data-state="1">@L.T("ItemState.RunningLow")</span>
                        <span class="state-opt is-readonly is-active" data-state="2">@L.T("ItemState.OutOfStock")</span>
                        <button type="button" class="purchase-btn" title="@L.T("Shopping.PurchaseButton")">
                            <i class="fa-solid fa-check" aria-hidden="true"></i>
                        </button>
                    </div>
                </div>
            </div>
        </li>
    </template>
</section>

@section Styles {
    <link rel="stylesheet" href="~/css/shopping.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/state-dots.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/item-cards.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/lottie.js" asp-append-version="true"></script>
    <script src="~/js/shopping.js" asp-append-version="true"></script>
    <script src="~/js/items-view.js" asp-append-version="true"></script>
}
