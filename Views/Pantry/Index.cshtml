@model Moonatna.ViewModels.Pantries.PantryIndexViewModel
@inject ILocalizationService Localization
@{
    var L = await Localization.GetStringsAsync();
    ViewData["Title"] = L.T("Nav.Pantry");

    var groups = Model.Items
        .GroupBy(i => i.CategoryName)
        .ToList();

    var stateKeys = new[] { "ItemState.Available", "ItemState.RunningLow", "ItemState.OutOfStock" };
}

@section Styles {
    <link rel="stylesheet" href="~/css/pantry.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/state-dots.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/item-cards.css" asp-append-version="true" />
}

<section class="items-page rise"
         data-state-picker
         data-layout-key="pantry"
         data-set-state-url="@Url.Action("SetState", "Items")"
         data-uncategorized="@L.T("Common.Uncategorized")">

    <header class="page-header">
        <h1>@L.T("Pantry.Title")</h1>
        <div class="layout-toggle" role="group" aria-label="@L.T("Common.LayoutChoice")">
            <button type="button" data-layout="full" aria-pressed="true" title="@L.T("Common.LayoutFull")">
                <i class="fa-solid fa-table-cells-large" aria-hidden="true"></i>
            </button>
            <button type="button" data-layout="grid" aria-pressed="false" title="@L.T("Common.LayoutGrid")">
                <i class="fa-solid fa-grip" aria-hidden="true"></i>
            </button>
        </div>
    </header>

    <div class="empty-state" id="empty-state" @(Model.Items.Count > 0 ? "hidden" : null)>
        <div class="lottie-mount" data-lottie="float"></div>
        <p>@L.T("Pantry.Empty")</p>
    </div>

    <div id="items-list">
        @foreach (var group in groups)
        {
            <section class="category-group" data-category-group="@(group.Key ?? "")">
                <h2>@(group.Key ?? L.T("Common.Uncategorized"))</h2>
                <ul>
                    @foreach (var item in group)
                    {
                        <li class="item-row" data-item-id="@item.Id" data-state="@((int)item.State)" data-category-id="@(item.CategoryId?.ToString() ?? "")">
                            @if (!string.IsNullOrEmpty(item.ImagePath))
                            {
                                <img class="item-thumb" src="@item.ImagePath" alt="@item.Name" loading="lazy" role="button" tabindex="0" />
                            }
                            else
                            {
                                <span class="item-thumb item-thumb-icon">
                                    <partial name="_CategoryIcon" model="item.CategoryIcon ?? new CategoryIconViewModel()" />
                                </span>
                            }
                            <div class="item-card-body">
                                <span class="item-name">@item.Name</span>
                                @if (item.Quantity is > 0)
                                {
                                    <span class="qty-tag">@item.Quantity</span>
                                }
                                @for (var s = 0; s <= 2; s++)
                                {
                                    var isActive = (int)item.State == s;
                                    <button type="button"
                                            class="state-opt@(isActive ? " is-active" : "")"
                                            data-state="@s"
                                            aria-pressed="@(isActive ? "true" : "false")">@L.T(stateKeys[s])</button>
                                }
                            </div>
                        </li>
                    }
                </ul>
            </section>
        }
    </div>

    @* template for rows added by pantry.js (quick-add) *@
    <template id="item-row-template">
        <li class="item-row" data-item-id="0" data-state="0">
            <img class="item-thumb" alt="" loading="lazy" role="button" tabindex="0" hidden />
            <span class="item-thumb item-thumb-icon" hidden><i class="fa-solid fa-basket-shopping" aria-hidden="true"></i></span>
            <div class="item-card-body">
                <span class="item-name"></span>
                <span class="qty-tag" hidden></span>
                <button type="button" class="state-opt is-active" data-state="0" aria-pressed="true">@L.T("ItemState.Available")</button>
                <button type="button" class="state-opt" data-state="1" aria-pressed="false">@L.T("ItemState.RunningLow")</button>
                <button type="button" class="state-opt" data-state="2" aria-pressed="false">@L.T("ItemState.OutOfStock")</button>
            </div>
        </li>
    </template>

</section>

@* Lives outside .items-page on purpose: that section's "rise" entrance
   animation sets a CSS transform, which makes it a containing block for
   position:fixed descendants — this sheet would then anchor to the
   section's box instead of the viewport. *@
<div class="item-actions-scrim" id="itemActionsScrim"></div>
<div class="item-actions-sheet" id="itemActionsSheet"
     data-delete-url="@Url.Action("Delete", "Items")">
    <div class="item-actions-list" id="itemActionsList">
        <button type="button" class="item-action-btn" id="itemActionEdit">
            <i class="fa-solid fa-pen" aria-hidden="true"></i>
            <span>@L.T("Pantry.Edit")</span>
        </button>
        <button type="button" class="item-action-btn danger" id="itemActionDelete">
            <i class="fa-solid fa-trash" aria-hidden="true"></i>
            <span>@L.T("Pantry.Delete")</span>
        </button>
    </div>
    <div class="item-actions-confirm" id="itemActionsConfirmBox" hidden>
        <p>@L.T("Pantry.DeleteConfirm")</p>
        <div class="item-actions-confirm-row">
            <button type="button" class="item-action-btn" id="itemActionCancelDelete">@L.T("Common.Cancel")</button>
            <button type="button" class="item-action-btn danger" id="itemActionConfirmDelete">@L.T("Pantry.Delete")</button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/lottie.js" asp-append-version="true"></script>
    <script src="~/js/state-dots.js" asp-append-version="true"></script>
    <script src="~/js/pantry.js" asp-append-version="true"></script>
    <script src="~/js/items-view.js" asp-append-version="true"></script>
}
