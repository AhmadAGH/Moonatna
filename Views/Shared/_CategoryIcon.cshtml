@model CategoryIconViewModel
@inject IWebHostEnvironment Env
@* One category icon, either kind — see CategoryIconViewModel.

   A local icon is drawn as <img> so the designer's SVG keeps its own
   colours and shape exactly as exported; a Font Awesome glyph stays an
   <i> and keeps inheriting currentColor from whatever surrounds it.

   The file has to actually be on disk: a row pointed at an icon that
   didn't ship (or a typo in IconPath) falls back to the Font Awesome
   glyph rather than rendering an empty box. asp-append-version stamps
   the URL with the file's hash, so a redesigned icon replaces the one
   the service worker cached instead of being served stale forever. *@
@{
    var hasIconFile = Model.UsesLocalIcon
        && Env.WebRootFileProvider.GetFileInfo(Model.IconPath!).Exists;
}
@if (hasIconFile)
{
    <img class="cat-icon" src="@Model.IconPath" asp-append-version="true" alt="" aria-hidden="true" loading="lazy" />
}
else
{
    <i class="@Model.ResolvedClass" aria-hidden="true"></i>
}
