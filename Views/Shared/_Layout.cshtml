@inject ILocalizationService Localization
@{
    var L = await Localization.GetStringsAsync();
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>@ViewData["Title"] - @L.T("App.Name")</title>
    <link rel="manifest" href="~/manifest.webmanifest" />
    <meta name="theme-color" content="#0d7377" />
    <link rel="icon" type="image/png" href="~/img/logo.png" />
    <link rel="apple-touch-icon" href="~/img/logo.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="موناتنا" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Rubik:wght@400;500;600;700;800&display=swap" />
    <link rel="stylesheet" href="~/css/layout.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header class="topbar">
        @if (isAuthenticated)
        {
            <a class="brand" asp-controller="Pantry" asp-action="Index">@L.T("App.Name")</a>
            <nav class="main-nav">
                <a asp-controller="Pantry" asp-action="Index">@L.T("Nav.Pantry")</a>
                <a asp-controller="Shopping" asp-action="Index">@L.T("Nav.Shopping")</a>
                <a asp-controller="Recipes" asp-action="Index">@L.T("Nav.Recipes")</a>
                <a asp-controller="Organize" asp-action="Index">@L.T("Nav.Organize")</a>
                <a asp-controller="Family" asp-action="Settings">@L.T("Nav.Family")</a>
            </nav>
            <form asp-controller="Auth" asp-action="Logout" method="post" class="logout-form">
                <button type="submit" class="link-button">@L.T("Nav.Logout")</button>
            </form>
        }
        else
        {
            <span class="brand">@L.T("App.Name")</span>
        }
    </header>

    <main class="page">
        @RenderBody()
    </main>

    <script src="~/js/register.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
